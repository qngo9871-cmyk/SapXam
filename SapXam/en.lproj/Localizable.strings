"rules.title" = "Full Rules";
"rules.done" = "Done";
"rules.deal.title" = "The Deal";
"rules.deal.body" = "2-4 players (you + AI). Everyone gets 13 cards from a standard 52-card deck, all at once — no draws, no discards.";
"rules.arrange.title" = "Arranging Your Hand";
"rules.arrange.body" = "Split your 13 cards into a Back hand (5 cards), a Middle hand (5 cards), and a Front hand (3 cards).";
"rules.ranks.title" = "Hand Rankings";
"rules.ranks.body" = "Back and Middle use standard poker rankings: High Card, Pair, Two Pair, Three of a Kind, Straight, Flush, Full House, Four of a Kind, Straight Flush. Front (3 cards) can only be High Card, Pair, or Three of a Kind — no straights or flushes.";
"rules.foul.title" = "Fouling";
"rules.foul.body" = "Back must rank equal to or higher than Middle, and Middle must rank equal to or higher than Front. If not, your hand is \"fouled\" — you automatically lose all three hands against every opponent this round.";
"rules.special.title" = "Instant Wins (Tới Trắng)";
"rules.special.body" = "Rồng Cuốn (13-card straight, one suit, 24×) > Sảnh Rồng (13-card straight, mixed suits, 12×) > Lục Phé Bôn (six pairs + 1 card, 6×) > Ba Cái Thùng (three flushes, 3×) > Ba Cái Sảnh (three straights, 3×). Any of these wins the round instantly against every opponent at that multiplier, before arranging.";
"rules.scoring.title" = "Scoring";
"rules.scoring.body" = "Your Back, Middle, and Front are each compared against every opponent's corresponding hand: +1 unit per hand won, -1 per hand lost. Win all three against one opponent and you also get a +3 scoop bonus against them.";

