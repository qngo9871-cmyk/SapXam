"rules.title" = "Luật Đầy Đủ";
"rules.done" = "Xong";
"rules.deal.title" = "Chia Bài";
"rules.deal.body" = "2-4 người chơi (bạn + AI). Mỗi người được chia 13 lá từ bộ bài 52 lá tiêu chuẩn, chia một lần — không rút thêm, không bỏ bài.";
"rules.arrange.title" = "Xếp Bài";
"rules.arrange.body" = "Chia 13 lá bài thành Chi Sau (5 lá), Chi Giữa (5 lá), và Chi Trước (3 lá).";
"rules.ranks.title" = "Thứ Hạng Bài";
"rules.ranks.body" = "Chi Sau và Chi Giữa dùng thứ hạng poker tiêu chuẩn: Mậu Thầu, Đôi, Thú, Sám Chi, Sảnh, Thùng, Cù Lũ, Tứ Quý, Thùng Phá Sảnh. Chi Trước (3 lá) chỉ có thể là Mậu Thầu, Đôi, hoặc Sám Chi — không có sảnh hay thùng.";
"rules.foul.title" = "Bể Chi";
"rules.foul.body" = "Chi Sau phải bằng hoặc mạnh hơn Chi Giữa, và Chi Giữa phải bằng hoặc mạnh hơn Chi Trước. Nếu không, bài của bạn bị \"bể chi\" — tự động thua cả ba chi trước mọi đối thủ trong ván đó.";
"rules.special.title" = "Thắng Ngay (Tới Trắng)";
"rules.special.body" = "Rồng Cuốn (sảnh 13 lá cùng chất, x24) > Sảnh Rồng (sảnh 13 lá khác chất, x12) > Lục Phé Bôn (sáu đôi + 1 lá lẻ, x6) > Ba Cái Thùng (cả ba chi đều là thùng, x3) > Ba Cái Sảnh (cả ba chi đều là sảnh, x3). Có một trong các bài này sẽ thắng ngay tất cả đối thủ với hệ số tương ứng, không cần xếp bài.";
"rules.scoring.title" = "Tính Điểm";
"rules.scoring.body" = "Chi Sau, Chi Giữa và Chi Trước của bạn được so với chi tương ứng của từng đối thủ: +1 điểm mỗi chi thắng, -1 mỗi chi thua. Thắng cả ba chi trước một đối thủ, bạn được cộng thêm +3 điểm thưởng với đối thủ đó.";

